---
import 'zdp-design-system/foundation.css';
import 'zdp-design-system/components/Button.css';
import 'zdp-design-system/components/IconButton.css';
import 'zdp-design-system/components/ConfirmAction.css';
import 'zdp-design-system/components/CodeBlock.css';
import 'zdp-design-system/components/Input.css';
import 'zdp-design-system/components/Select.css';
import 'zdp-design-system/components/Disclosure.css';
import 'zdp-design-system/components/ResizableSplitPane.css';
import 'zdp-design-system/components/Progress.css';
import 'zdp-design-system/components/Spinner.css';
import 'zdp-design-system/components/Skeleton.css';
---
<html lang="en">
  <head><meta charset="UTF-8" /><title>Static design system consumer</title></head>
  <body>
    <div class="zdp-code-block zdp-code-block--md zdp-code-block--default" data-testid="static-code-copy" role="group" aria-label="Static code example">
      <div class="zdp-code-block__header">
        <div class="zdp-code-block__meta"><span class="zdp-code-block__title">Example</span></div>
        <button class="zdp-code-block__copy" type="button" data-copy-state="idle">
          <span class="zdp-code-block__copy-spinner" aria-hidden="true"></span>
          <span class="zdp-code-block__copy-label" aria-live="polite">Copy</span>
        </button>
      </div>
      <div class="zdp-code-block__scroller" role="region" aria-label="Static code" tabindex="0"><pre class="zdp-code-block__pre"><code class="zdp-code-block__code">console.log('Astro');</code></pre></div>
    </div>
    <button class="zdp-button zdp-button--primary zdp-button--md" type="button">Static action</button>
    <section data-testid="static-button-loading" data-zdp-theme="light">
      <div data-testid="static-button-loading-variants" style="display:flex;flex-wrap:wrap;gap:12px;padding:12px">
        {['primary', 'secondary', 'danger', 'text'].map(variant => ['sm', 'md'].map(size => (
          <button class={`zdp-button zdp-button--${variant} zdp-button--${size}`} type="button" data-loading="false">
            <span class="zdp-button__spinner" aria-hidden="true"></span>
            Save {variant} {size}
          </button>
        )))}
      </div>
    </section>
    <section data-testid="static-icon-button-loading" data-zdp-theme="light">
      <div data-testid="static-icon-button-loading-variants" style="display:flex;flex-wrap:wrap;gap:12px;padding:12px">
        {['ghost', 'solid'].map(variant => ['sm', 'md'].map(size => (
          <button class={`zdp-icon-button zdp-icon-button--${variant} zdp-icon-button--${size}`} type="button" aria-label={`Save ${variant} ${size}`} title={`Action ${variant} ${size}`} aria-pressed="true">
            <span class={`zdp-icon zdp-icon--${size} zdp-icon-button__glyph`} aria-hidden="true">+</span>
            <span class={`zdp-icon zdp-icon--${size} zdp-icon-button__spinner`} aria-hidden="true"></span>
          </button>
        )))}
      </div>
    </section>
    <section data-testid="static-confirm-pending" data-zdp-theme="light" style="display:flex;flex-wrap:wrap;gap:12px;padding:12px">
      {['primary', 'danger'].map(tone => (
        <button class={`zdp-confirm-action zdp-confirm-action--${tone}`} type="button" style="--zdp-confirm-action-progress:0">
          <span class="zdp-confirm-action__fill" aria-hidden="true"></span>
          <span class="zdp-confirm-action__thumb" aria-hidden="true">
            <span class="zdp-confirm-action__spinner" aria-hidden="true"></span>
            <svg class="zdp-confirm-action__glyph" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
          </span>
          <span class="zdp-confirm-action__body">
            <span class="zdp-confirm-action__label">Confirm {tone}</span>
            <span class="zdp-confirm-action__hint">Hold or slide to confirm</span>
          </span>
        </button>
      ))}
    </section>
    <section style="display:grid;gap:12px;max-width:400px;padding:16px">
      <input class="zdp-input" aria-label="Static input" placeholder="Name" />
      <span class="zdp-select-shell">
        <select class="zdp-select" aria-label="Static selection"><option>Platform team</option><option>Security team</option></select>
        <span class="zdp-select__arrow" aria-hidden="true"></span>
      </span>
      <div class="zdp-disclosure" data-open="false">
        <button class="zdp-disclosure__trigger" type="button" aria-expanded="false">
          <span class="zdp-disclosure__title">Static disclosure</span><span class="zdp-disclosure__mark" aria-hidden="true"></span>
        </button>
      </div>
    </section>
    <div class="zdp-progress zdp-progress--primary zdp-progress--md" data-indeterminate="true" role="progressbar" aria-label="Static waiting progress">
      <span class="zdp-progress__track" aria-hidden="true"><span class="zdp-progress__bar"></span></span>
    </div>
    <div data-testid="static-spinners">
      {['sm', 'md', 'lg'].map(size => (
        <span class={`zdp-spinner zdp-spinner--primary zdp-spinner--${size}`} role="status" aria-label={`Static spinner ${size}`}>
          <span class="zdp-spinner__mark" aria-hidden="true"></span>
        </span>
      ))}
    </div>
    <div id="workspace" style="display:grid;grid-template-columns:240px 8px 1fr;width:800px;height:240px">
      <nav id="primary">Navigation</nav>
      <div id="separator"></div>
      <main id="secondary">Static Astro content</main>
    </div>
    {[true, false].map(animated => (
      <div data-testid={`static-skeletons-${animated ? 'animated' : 'static'}`} style="max-width:300px">
        {['text', 'block', 'avatar'].map(variant => (
          <div class={`zdp-skeleton zdp-skeleton--${variant}`} data-animated={String(animated)} aria-hidden="true">
            <span class="zdp-skeleton__line zdp-skeleton__line--last" aria-hidden="true"></span>
          </div>
        ))}
      </div>
    ))}
    <script>
      import { createZdpSplitPaneController } from 'zdp-design-system/split-pane';
      const controller = createZdpSplitPaneController({
        root: document.querySelector<HTMLElement>('#workspace')!,
        primary: document.querySelector<HTMLElement>('#primary')!,
        separator: document.querySelector<HTMLElement>('#separator')!,
        secondary: document.querySelector<HTMLElement>('#secondary')!
      }, { size: 240, minSize: 180, maxSize: 360, secondaryMinSize: 240 });
      document.addEventListener('astro:before-swap', () => controller.destroy(), { once: true });
    </script>
  </body>
</html>
