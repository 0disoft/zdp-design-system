---
import 'zdp-design-system/styles.css';
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self'; font-src 'self'" />
    <title>Shared CSS consumer</title>
  </head>
  <body>
    <label class="zdp-choice zdp-choice--checkbox">
      <input type="checkbox" class="zdp-choice__input" aria-label="Checkbox" />
      <span class="zdp-choice__mark"></span>
    </label>
    <label class="zdp-choice zdp-choice--radio">
      <input type="radio" class="zdp-choice__input" aria-label="Radio" />
      <span class="zdp-choice__mark"></span>
    </label>
  </body>
</html>
